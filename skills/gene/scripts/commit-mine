#!/usr/bin/env bash
# Commit verified explicit edits through a private index; never write the shared index.
#
#   commit-mine -m "Add the thing"       commit recorded edits
#   commit-mine -m "..." path/a path/b   only those recorded paths
#   commit-mine --dry-run                show what would land
# Shell edits and unsupported operations require separate review.
set -u
# -P resolves through the installed skill link back to the repository root.
DIR="$(cd -P "$(dirname "$0")/../../.." && pwd)"
# shellcheck source=hooks/lib/ledger.sh
. "$DIR/hooks/lib/ledger.sh"

ORIGINAL_ARGS=("$@")

MSG=""; DRY=0; ONLY=()
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message)  MSG="$2"; shift 2 ;;
    -F|--file)     MSG="$(cat "$2")"; shift 2 ;;
    -n|--dry-run)  DRY=1; shift ;;
    -h|--help)     sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            echo "commit-mine: unknown flag $1" >&2; exit 2 ;;
    *)             ONLY+=("$1"); shift ;;
  esac
done

if [ "${LEDGER_LOCKED:-}" != 1 ]; then
  exec python3 "$DIR/hooks/lib/ledger_capture.py" run "$0" "${ORIGINAL_ARGS[@]}"
fi

# After the arguments, so -F reads its file where it was typed. Paths given are
# matched against the ledger's keys, which are repo-relative either way.
ledger_cd_root || { echo "commit-mine: not a git repo" >&2; exit 1; }
ledger_dir >/dev/null 2>&1 || { echo "commit-mine: not a git repo, or no session id" >&2; exit 1; }
base="$(git rev-parse -q --verify HEAD)" || { echo "commit-mine: no commits yet" >&2; exit 1; }

paths="$(ledger_paths)"
[ ${#ONLY[@]} -gt 0 ] && paths="$(printf '%s\n' "${ONLY[@]}")"
[ -n "$paths" ] || { echo "commit-mine: no verified explicit edits recorded (shell edits are not tracked)"; exit 0; }

gd="$(git rev-parse --absolute-git-dir)"
idx="$gd/commit-mine-index.$$"
export GIT_INDEX_FILE="$idx"
git read-tree "$base"

landing=(); skipped=()
while IFS= read -r p; do
  [ -n "$p" ] || continue
  entry="$(ledger_get "$p")"
  [ -n "$entry" ] || { skipped+=("$p — not this session's"); continue; }
  IFS=$'\t' read -r origin shadow status origin_mode <<< "$entry"
  [ "$status" = verified ] || { skipped+=("$p — unverified or tangled with another session's edit"); continue; }
  # Nothing of this session's to replay. Replayed anyway onto a HEAD that has
  # since dropped the file, the no-op merges into emptiness and resurrects it.
  [ "$origin" = "$shadow" ] && { skipped+=("$p — unchanged by this session"); continue; }

  if [ "$shadow" = "-" ]; then
    # The tree outranks the record. A file that is on disk now was recreated by
    # someone, or was never really gone; committing its removal either way
    # destroys work no one asked to lose.
    { [ -e "$p" ] || [ -L "$p" ]; } && { skipped+=("$p — deleted here but present in the tree"); continue; }
    head_mode="$(git ls-tree "$base" -- "$p" | awk '{print $1}')"
    { [ "$(_ledger_head_blob "$p")" = "$origin" ] && [ "$head_mode" = "$origin_mode" ]; } || { skipped+=("$p — changed in HEAD since deletion was recorded"); continue; }
    git update-index --force-remove -- "$p" && landing+=("$p"); continue
  fi
  head_blob="$(git rev-parse -q --verify "$base:$p" 2>/dev/null)" || head_blob="-"
  if [ "$head_blob" = "$origin" ]; then
    merged="$shadow"                                   # HEAD has not moved under us
  elif ! merged="$(ledger_merge3 "$head_blob" "$origin" "$shadow")"; then
    skipped+=("$p — conflicts with what is already committed"); continue
  fi
  [ "$merged" = "$head_blob" ] && { skipped+=("$p — already in HEAD"); continue; }
  mode="$(git ls-tree "$base" -- "$p" 2>/dev/null | awk '{print $1}')"
  [ -n "$mode" ] || mode="${origin_mode:-100644}"
  git update-index --add --cacheinfo "$mode,$merged,$p" && landing+=("$p")
done <<< "$paths"

tree="$(git write-tree)"
unset GIT_INDEX_FILE; rm -f "$idx"

report() {
  [ ${#landing[@]} -gt 0 ] && { echo "landing:"; printf '  %s\n' "${landing[@]}"; }
  [ ${#skipped[@]} -gt 0 ] && { echo "skipped:"; printf '  %s\n' "${skipped[@]}"; }
  return 0
}

[ ${#landing[@]} -gt 0 ] || { echo "commit-mine: nothing to commit"; report; exit 0; }
[ "$DRY" = 1 ] && { echo "(dry run)"; report; git diff --stat "$base" "$tree"; exit 0; }
[ -n "$MSG" ] || { echo "commit-mine: a message is required (-m)" >&2; exit 2; }

sha="$(printf '%s\n' "$MSG" | git commit-tree "$tree" -p "$base")"
if ! git update-ref -m "commit: $(printf '%s' "$MSG" | head -1)" HEAD "$sha" "$base" 2>/dev/null; then
  echo "commit-mine: HEAD moved while this commit was being built (another session landed one)." >&2
  echo "             Nothing was committed. Re-run — the ledger is unchanged." >&2
  exit 1
fi

ledger_drop "${landing[@]}"
echo "committed $(git rev-parse --short HEAD)  $(printf '%s' "$MSG" | head -1)"
report
